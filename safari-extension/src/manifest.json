{
  "manifest_version": 3,
  "name": "B2M Sender",
  "short_name": "B2M",
  "description": "Send the current MakerWorld model page to your Manyfold sync server.",
  "version": "1.0.1",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Send to Manyfold",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://modelsync.townsville.cc/*",
    "https://makerworld.com/*"
  ]
}
